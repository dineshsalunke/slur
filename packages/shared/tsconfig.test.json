{
    // Test-only compile: adds node types (for node:test / node:assert) that the framework-free lib
    // build deliberately omits. Emits to test-dist/ (gitignored), run via `node --test test-dist`.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "outDir": "test-dist",
        "types": [ "node" ],
        "noEmit": false
    },
    "include": [ "src" ]
}

{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": "src",
        "outDir": "dist",
        // Keep the incremental build cache INSIDE dist so `rm -rf dist` resets output and cache together.
        // Default puts it at packages/shared/tsconfig.tsbuildinfo (outside dist), so wiping only dist leaves a
        // stale cache → `tsc -b` thinks it's up-to-date and skips emit, and dist never rebuilds (#75).
        "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
        "module": "NodeNext",
        "moduleResolution": "nodenext"
    },
    "include": [ "src" ],
    // Tests compile via tsconfig.test.json (they need node types). Keeping them out of the lib build
    // means the shipped dist stays framework-free — no node globals leak into browser-run sim code.
    "exclude": [ "src/**/*.test.ts" ]
}

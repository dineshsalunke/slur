{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "ignoreUnknown": true,
        "includes": [ "**", "!docs/references", "!docs/art-direction", "!.claude/skills" ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "delimiterSpacing": true
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "bracketSpacing": true
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": { "maxAllowedComplexity": 15 }
                }
            },
            "style": {
                "noExcessiveLinesPerFile": {
                    "level": "warn",
                    "options": { "maxLines": 300, "skipBlankLines": true }
                }
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "apps/client/app/**/*.tsx",
                "!apps/client/app/**/*.test.tsx",
                "!apps/client/app/game/overlays/mount-overlays.tsx"
            ],
            "plugins": [ "./biome-plugins/component-module-scope.grit" ]
        }
    ]
}

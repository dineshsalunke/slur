# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
test-dist/
build/
out/
*.tsbuildinfo

# Vite / caches
.vite/
.cache/
.turbo/

# React Router (framework mode) typegen output
.react-router/

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test / coverage
coverage/

# Throwaway prototypes / inspectors (never committed; excluded from lint via biome useIgnoreFile)
scratchpad/

# Per-machine Claude Code state — never shared.
.claude/settings.local.json

# Art drafts stay local; approved work is promoted to its subject folder.
# Keep the existing archive versionable and retain empty draft folders via .gitkeep.
/docs/art-direction/golden-reference/explorations/*
/docs/art-direction/background/explorations/*
/docs/art-direction/track/explorations/*
/docs/art-direction/progression/explorations/*
/docs/art-direction/ingredients/**/explorations/*
/docs/art-direction/vehicles/**/explorations/*
!/docs/art-direction/**/explorations/.gitkeep

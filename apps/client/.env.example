# Per-worktree dev port overrides (issue #59) — copy to apps/client/.env (gitignored) and edit.
#
# Lets a SECOND agent/worktree run a full dev stack alongside the first without fighting
# :5173/:2567. Defaults (no .env) stay 5173/2567, so single-agent use and office LAN play
# are unchanged. Vite auto-loads THIS directory's .env, so the two client vars below need no
# shell fiddling. The server has no .env loader (tsx watch), so its PORT is a shell var —
# see the launch line at the bottom.

# Vite dev-server port (this client). Read by vite.config.ts via loadEnv. Default 5173.
CLIENT_PORT=5174

# WebSocket server port the client CONNECTS to. Inlined into the bundle as
# import.meta.env.VITE_SERVER_PORT. MUST match the PORT the server LISTENs on. Default 2567.
VITE_SERVER_PORT=2568

# The server reads process.env.PORT (already env-driven) but tsx does not load this file, so
# launch this worktree's stack with a matching PORT exported in the shell, e.g.:
#
#   PORT=2568 pnpm dev        # server listens on 2568; client reads CLIENT_PORT/VITE_SERVER_PORT here
#
# (PORT must equal VITE_SERVER_PORT above.)

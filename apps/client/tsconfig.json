{
    "include": [ "**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*" ],
    "compilerOptions": {
        "lib": [ "DOM", "DOM.Iterable", "ES2022" ],
        "types": [ "node", "vite/client" ],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "rootDirs": [ ".", "./.react-router/types" ],
        "paths": {
            "~/*": [ "./app/*" ]
        },
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        // Permits `import … from './x.ts'`. Needed by vite.config.ts, whose relative import of
        // ./art-refs-plugin.ts must carry the extension: Vite 8's forthcoming native config loader
        // (Node type-stripping) cannot resolve it otherwise and warns on every dev/build run.
        // Legal only because noEmit is on; purely permissive elsewhere.
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true
    }
}
